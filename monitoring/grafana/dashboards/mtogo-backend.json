{
  "title": "MTOGO Backend",
  "uid": "mtogo-backend",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prometheus scrape status",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mtogo-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"mtogo-backend\"}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Down", "color": "red" },
                "1": { "text": "Up", "color": "green" }
              }
            }
          ]
        }
      },
      "options": { "graphMode": "none", "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP requests by status",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mtogo-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(mtogo_http_request_duration_seconds_count{job=\"mtogo-backend\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP request latency (p95)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mtogo-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mtogo_http_request_duration_seconds_bucket{job=\"mtogo-backend\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mtogo-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_memory_used_bytes{job=\"mtogo-backend\",area=\"heap\"}",
          "legendFormat": "Heap used"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } }
    }
  ]
}
